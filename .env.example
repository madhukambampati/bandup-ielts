# Required: your Anthropic API key (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=sk-ant-...

# Optional
DAILY_LIMIT=25                 # AI checks per visitor per day
MODEL_MARK=claude-sonnet-5-5   # Writing + Speaking marking
MODEL_FAST=claude-haiku-5-5    # Tutor + study plan

# Optional but recommended once the site is public: a free Upstash Redis database
# makes the daily limit reliable across all servers (Vercel → Storage → Upstash).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
