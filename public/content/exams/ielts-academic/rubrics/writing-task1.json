{
  "id": "writing-task1",
  "name": "IELTS Academic Writing Task 1",
  "scaleRef": "self",
  "aggregate": "mean-round-half-band",
  "criteria": [
    { "key": "ta", "name": "Task Achievement",
      "factors": ["Covers the requirements of the task", "Presents a clear overview of main trends or stages", "Reports key features accurately", "Figures quoted match the data"] },
    { "key": "cc", "name": "Coherence and Cohesion",
      "factors": ["Logical organisation", "Clear progression", "Range of cohesive devices", "Paragraphing"] },
    { "key": "lr", "name": "Lexical Resource",
      "factors": ["Range of vocabulary", "Accuracy of word choice", "Collocation", "Spelling"] },
    { "key": "gra", "name": "Grammatical Range and Accuracy",
      "factors": ["Range of structures", "Accuracy", "Punctuation", "Error density"] }
  ],
  "cannotAssess": [],
  "outputs": ["summary", "strengths", "fixes", "next_step", "model_paragraph"]
}
